# Required in production (Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production

# Optional: set PGSSL=false for local Postgres without SSL
# PGSSL=false

# Payment
PAYMENT_MODE=sandbox
LIVE_TAKE_PROFIT_URL=https://api.paymentgateway.com/v1
LIVE_TAKE_PROFIT_API_KEY=your_live_take_profit_api_key_here

# Optional: seed extra demo manager accounts (off by default in production)
# SEED_DEMO_USERS=true
